# Database
DB_URL=jdbc:postgresql://db.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_password

# Default Admin Credentials
ADMIN_DEFAULT_EMAIL=admin@wellpoint.com
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password

# JWT
JWT_SECRET=your_256bit_secret_here
JWT_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# LLM (Groq)
LLM_PROVIDER=groq
LLM_API_KEY=gsk_...
LLM_MODEL=llama3-8b-8192
LLM_BASE_URL=https://api.groq.com/openai/v1

# Email
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG....
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Healthcare App

# Google Calendar
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/v1/calendar/callback
CALENDAR_ENCRYPTION_KEY=your_32byte_aes_key

# App
FRONTEND_URL=https://your-app.vercel.app
