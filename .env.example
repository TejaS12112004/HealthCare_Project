# Database
DB_URL=jdbc:postgresql://db.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_password

# JWT
JWT_SECRET=your_256bit_secret_here
JWT_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Email
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG....
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Healthcare App

# Google Calendar
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/v1/calendar/callback
CALENDAR_ENCRYPTION_KEY=your_32byte_aes_key

# App
FRONTEND_URL=https://your-app.vercel.app
